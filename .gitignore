# Dependencies
node_modules/
*/node_modules/
client/node_modules/
server/node_modules/

# Production Build Output
dist/
client/dist/
build/

# Environment Variables & Secrets
.env
*.env
*.env*
.env.*
server/.env

# Local Uploads / Media Storage (Avoid committing large 4K binaries to Git)
server/uploads/wallpapers/*
server/uploads/thumbnails/*
server/uploads/categories/*
!server/uploads/wallpapers/.gitkeep
!server/uploads/thumbnails/.gitkeep
!server/uploads/categories/.gitkeep

# Local database cache / backup
server/data/*.tmp

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & System Files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
Desktop.ini
