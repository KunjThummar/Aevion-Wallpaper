# Server Port
PORT=5000

# Optional: MongoDB URI (If empty, automatically uses local high-speed JSON storage)
MONGODB_URI=mongodb://127.0.0.1:27017/aevion_wallpapers

# Optional: 100% Certified Free API Keys for Infinite Live Sourcing
# Get free key (50 req/hr) at: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# Get free key (200 req/hr) at: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key

# Site Domain URL
SITE_URL=https://aevionwallpapers.com
